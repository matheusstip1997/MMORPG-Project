<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer\GameServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine-free Unity client sources (connection, prediction and entity cores, backlog D1) compiled for .NET:
         run against the real server loop. BotClient plays the game with them (backlog J). -->
    <ProjectReference Include="..\..\src\Tools\ClientCore\ClientCore.csproj" />
    <!-- Bots, the link relay and the load-test report (backlog J), run against the real server here. -->
    <ProjectReference Include="..\..\src\Tools\BotClient\BotClient.csproj" />
    <!-- The skill-tree generator (WP-M2-5): its round trip over the committed design file and tables. -->
    <ProjectReference Include="..\..\src\Tools\SkillTreeGen\SkillTreeGen.csproj" />
  </ItemGroup>

</Project>