<Project Sdk="Microsoft.NET.Sdk">

  <!-- The server's dev tools flag (spec 11.7): their tests build only when the server has them. -->
  <Import Project="..\..\src\GameServer\DevTools.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(DevTools)' != 'true'">
    <Compile Remove="Dev\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer\GameServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine-free Unity client sources (connection, prediction and entity cores, backlog D1) compiled for .NET:
         run against the real server loop. BotClient plays the game with them (backlog J). -->
    <ProjectReference Include="..\..\src\Tools\ClientCore\ClientCore.csproj" />
    <!-- Bots, the link relay and the load-test report (backlog J), run against the real server here. -->
    <ProjectReference Include="..\..\src\Tools\BotClient\BotClient.csproj" />
  </ItemGroup>

</Project>