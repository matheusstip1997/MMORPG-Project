<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" />
    <!-- The build Unity matches (netstandard2.1, C# 9): built here so SharedAssemblyTests can inspect it. -->
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" SetTargetFramework="TargetFramework=netstandard2.1"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SharedNetStandardAssembly"
                      Value="$(ArtifactsPath)/bin/Shared/$([System.String]::Copy('$(Configuration)').ToLowerInvariant())_netstandard2.1/Shared.dll" />
  </ItemGroup>

</Project>
