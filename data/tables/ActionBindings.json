    // The kits use Q E R F and 1.

    // Warrior: Stamina buff (1), Slash (Q), Head Cut (E), Piercing Attack (R), Jump Strike (F).
    { "classId": "warrior", "normalAttack": "attack.warrior", "dodge": "dodge", "parry": "parry",
      "skillSlots": ["skill.warrior.staminaBuff", "", "", "", "", "", "skill.warrior.slash", "skill.warrior.headCut", "skill.warrior.piercingAttack", "skill.warrior.jumpStrike"] },

    // Archer: Dash (1), Piercing Shot (Q), Multi Shot (E), Heavy Shot (R), Back Step (F).
    { "classId": "archer", "normalAttack": "attack.archer", "dodge": "dodge", "parry": "parry",
      "skillSlots": ["skill.archer.dash", "", "", "", "", "", "skill.archer.piercingShot", "skill.archer.multiShot", "skill.archer.heavyShot", "skill.archer.backStep"] },

    // Mage: Magic Barrier (1), Fire Spark (Q), Ice Shard (E), Wind Cut (R), Flamethrower (F).
    { "classId": "mage", "normalAttack": "attack.mage", "dodge": "dodge", "parry": "parry",
