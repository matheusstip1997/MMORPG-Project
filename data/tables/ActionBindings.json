      "skillSlots": ["", "", "", "", "", "", "skill.warrior.slash", "skill.warrior.headCut", "skill.warrior.piercingAttack", "skill.warrior.jumpStrike"] },

    // Archer: Dash (1), Piercing Shot (Q), Multi Shot (E), Heavy Shot (R), Back Step (F).
    { "classId": "archer", "normalAttack": "attack.archer", "dodge": "dodge", "parry": "parry",
      "skillSlots": ["skill.archer.dash", "", "", "", "", "", "skill.archer.piercingShot", "skill.archer.multiShot", "skill.archer.heavyShot", "skill.archer.backStep"] },

    // PLACEHOLDER until their kits (wave 5): the class's own normal attack and the old placeholder skills on 1-6 and Q.
    { "classId": "mage", "normalAttack": "attack.mage", "dodge": "dodge", "parry": "parry",
      "skillSlots": ["skill.crossCut", "skill.heal", "skill.haste", "skill.cleanse", "skill.charge", "skill.fireCircle", "skill.arrowShot"] },
    { "classId": "assist", "normalAttack": "attack.assist", "dodge": "dodge", "parry": "parry",
      "skillSlots": ["skill.crossCut", "skill.heal", "skill.haste", "skill.cleanse", "skill.charge", "skill.fireCircle", "skill.arrowShot"] }
  ]
