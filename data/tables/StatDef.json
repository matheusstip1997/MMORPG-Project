    { "id": "bloodRes", "min": -900, "max": 100 },
    { "id": "poisonRes", "min": -900, "max": 100 },

    // WP-M2-2 (spec 3.4 "M2 primary attributes", R-3.4-01): STR, DEX, STA, INT from the class and the level (ClassDef),
