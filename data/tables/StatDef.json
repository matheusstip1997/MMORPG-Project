    { "id": "damageDealtPercent", "min": -100, "max": 1000 },
    { "id": "damageTakenPercent", "min": -100, "max": 1000 },
    // R-3.3-07: base from ClassDef or MonsterDef flinchResist; statuses can raise it (Magic Barrier).
    { "id": "flinchResist", "min": 0, "max": 10000 },

    // One resistance per element of R-3.4-07 (R-3.8-10), referenced by ElementCaps. Negative values are weaknesses.
    { "id": "fireRes", "min": -900, "max": 100 },
    { "id": "iceRes", "min": -900, "max": 100 },
    { "id": "waterRes", "min": -900, "max": 100 },
    { "id": "windRes", "min": -900, "max": 100 },
    { "id": "earthRes", "min": -900, "max": 100 },
