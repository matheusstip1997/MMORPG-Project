    { "id": "str", "min": 0, "max": 100000 },
    { "id": "dex", "min": 0, "max": 100000 },
    { "id": "sta", "min": 0, "max": 100000 },
    { "id": "int", "min": 0, "max": 100000 },

    // The rest of R-3.4-02 (WP-M2-2). Nothing reads these yet; the caps are placeholders (architecture rule 2).
