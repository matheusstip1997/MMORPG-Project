{
  "table": "UnlockSchedule",
  "version": 1,
  "rows": [
    // The tutorial's unlock schedule (spec 12.3 "M2 decisions", R-12.3-02; user decision 2026-10-28; PLACEHOLDERS): levels 1
    // to 10 in the city, the M1 combat area and ring 1. Each prompt shows once per character (R-12.3-03), when the trigger
    // happens at or after the row's level; hudElements are hidden below the level (spec 9.12 "HUD by level"). A package
    // that wants its HUD element to wait for a level adds its own row here. M2: no element waits (user decision 2026-10-28
    // after play: the exp bar and the minimap show from level 1; the hotbar listed at 1 shows from the start).
    // 1-4: movement, attack, dodge, parry, stamina, hotbar (the hotbar is visible from 1).
    { "id": "move", "level": 1, "trigger": "levelReached", "prompt": "tutorial.prompt.move",
      "hudElements": ["hotbar_left", "hotbar_right"] },
    { "id": "loot", "level": 1, "trigger": "lootInReach", "prompt": "tutorial.prompt.loot" },
    { "id": "dodge", "level": 2, "trigger": "levelReached", "prompt": "tutorial.prompt.dodge" },
    { "id": "parry", "level": 3, "trigger": "levelReached", "prompt": "tutorial.prompt.parry" },
    { "id": "skills", "level": 4, "trigger": "levelReached", "prompt": "tutorial.prompt.skills" },
    // 5-9: inventory and bags, selling at the outpost, the vendor, outpost quests.
    { "id": "inventory", "level": 5, "trigger": "levelReached", "prompt": "tutorial.prompt.inventory" },
    { "id": "sell", "level": 5, "trigger": "outpostInReach", "prompt": "tutorial.prompt.sell" },
    { "id": "vendor", "level": 5, "trigger": "vendorInReach", "prompt": "tutorial.prompt.vendor" },
    { "id": "board", "level": 5, "trigger": "itemSold", "prompt": "tutorial.prompt.board" },
    // 10: leave the tutorial (the gate of R-12.3-01 opens, RegionDef.minLevel).
    { "id": "leave", "level": 10, "trigger": "levelReached", "prompt": "tutorial.prompt.leave" },
    // 12-18: jobs (spec 5.1 M3 decisions, WP-M3-1): the pick at the job master opens at JobDef.minLevel. The prompt is not
    // shown, and closes, once a job is held (user decision 2026-10-30).
    { "id": "jobs", "level": 12, "trigger": "levelReached", "prompt": "tutorial.prompt.jobs", "hideWhen": "jobHeld" },
    // Gathering (WP-M3-11): the first available node of an own job in reach, so it needs no hide condition.
    { "id": "gather", "level": 12, "trigger": "nodeInReach", "prompt": "tutorial.prompt.gather" },
    // Crafting (WP-M3-11): the first forge or bench in reach while holding a job; it stays unseen until then.
    // Level 12 (user decision 2026-11-07, M3 decision 17): the trigger and the job already place it after the pick.
    { "id": "craft", "level": 12, "trigger": "stationInReach", "prompt": "tutorial.prompt.craft", "hideWhen": "noJobHeld" },
    // Mail (WP-M4-14, R-4.5-03, M4 decision 6a): the first mailbox in reach says the list is read anywhere and the attachments
    // are taken here. Level 1 is a placeholder (user answer 2026-11-13): mail can arrive at any level (an admin compensation).
    // TODO(open) M4 decision 14: the unlock level of each M4 feature.
    { "id": "mail", "level": 1, "trigger": "mailboxInReach", "prompt": "tutorial.prompt.mail" }
  ]
}
