{
  "table": "ReliableMessageCaps",
  "version": 1,
  // R-2.5-07: one row per reliable message a client may send; the server refuses a larger one before reading it.
  // Placeholders: each cap is the largest valid message today, so tightening one is a tuning decision.
  "rows": [
    {
      // Id byte, object header, uint drop id.
      "id": "pickupRequest",
      "maxBytes": 6
    },
    {
      // WP16 bag move: id byte, object header, uint request id, two byte slots, two byte container codes (WP-M2-1), the
      // ushort split count (WP-M2-11, protocol 24).
      "id": "inventoryMoveRequest",
      "maxBytes": 12
    },
    {
      // Id byte, object header, string headers, ChatSettings.maxChars (200) characters of up to 4 UTF-8 bytes.
      "id": "chatSend",
      "maxBytes": 810
    },
    {
      // WP-M2-4 NPC interaction: id byte, object header, uint request id, uint NPC entity id, byte kind.
      "id": "outpostInteractRequest",
      "maxBytes": 11
    },
    {
      // Quote: id byte, object header, uint request id, uint NPC entity id, byte slot, ushort count.
      "id": "sellQuoteRequest",
      "maxBytes": 13
    },
    {
      // Sale: the quote's fields and the long quoted total.
      "id": "sellRequest",
      "maxBytes": 21
    },
    {
      // Vendor purchase: id byte, object header, uint request id, uint NPC entity id, ushort item, ushort count, long total.
      "id": "vendorBuyRequest",
      "maxBytes": 22
    },
    {
      // Skill tree request (WP-M2-5): id byte, object header, uint request id, byte op, string target (MemoryPack UTF-8: two
      // int headers, then at most SkillTree.MaxIdBytes 48 ASCII bytes), byte slot.
      "id": "skillTreeRequest",
      "maxBytes": 64
    },
    {
      // Bystial book change (WP-M2-8): id byte, object header, uint request id, ushort monster net id, byte slot.
      "id": "bookChangeRequest",
      "maxBytes": 9
    },
    {
      // WP-M2-6 run request: id byte, object header, uint request id, uint NPC entity id, byte action, uint board epoch, byte
      // step index, and up to QuestMessages.MaxRunSteps (8) offer slots (int length and one byte each).
      "id": "questRunRequest",
      "maxBytes": 28
    },
    {
      // WP-M2-13 attribute point (R-3.4-08): id byte, object header, uint request id, byte attribute.
      "id": "attributeSpendRequest",
      "maxBytes": 7
    },
    {
      // WP-M3-1 job pick: id byte, object header, uint request id, uint NPC entity id, byte job net id, byte slot.
      "id": "jobRequest",
      "maxBytes": 12
    },
    {
      // WP-M3-3 consumable use (spec 3.4): id byte, object header, uint request id, byte container, byte slot.
      "id": "useItemRequest",
      "maxBytes": 8
    },
    {
      // WP-M3-5 harvesting (spec 5.2): id byte, object header, uint request id, uint node entity id.
      "id": "harvestRequest",
      "maxBytes": 10
    },
    {
      // WP-M3-6 forge (spec 5.3): id byte, object header, uint request id, uint station, byte kind, ushort def, then the
      // input array (int length, at most 8 inputs of object header + byte container + byte slot).
      "id": "forgeStart",
      "maxBytes": 41
    },
    {
      // WP-M3-6: id byte, object header, uint request id, byte action.
      "id": "forgeAction",
      "maxBytes": 7
    },
    {
      // WP-M3-6: id byte, object header, uint request id.
      "id": "forgeFinish",
      "maxBytes": 6
    },
    {
      // WP-M3-6: id byte, object header, uint request id.
      "id": "forgeCancel",
      "maxBytes": 6
    },
    {
      // WP-M3-7 job tree learn or respec: id byte, object header, uint request id, byte op, byte job net id, string node id
      // (MemoryPack UTF-8: two int headers, then at most JobTree.MaxIdBytes 48 ASCII bytes).
      "id": "jobTreeRequest",
      "maxBytes": 64
    },
    {
      // WP-M3-8 enchanting: id byte, object header, uint request id, uint station, byte container, byte slot, long instance.
      "id": "enchantRequest",
      "maxBytes": 20
    },
    {
      // WP-M3-10 forge timing bar press: id byte, object header, uint request id, byte round, uint offset in ms.
      "id": "forgeChallengeInput",
      "maxBytes": 11
    },
    {
      // WP-M3-9 gem socket or removal: id byte, object header, uint request id, uint station, byte op, byte container,
      // byte slot, long instance id, byte gem slot, byte gem index.
      "id": "gemRequest",
      "maxBytes": 23
    }
  ]
}
