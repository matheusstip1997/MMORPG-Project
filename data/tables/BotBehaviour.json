{
  "table": "BotBehaviour",
  "version": 1,
  "rows": [
    // Field combat with monsters (spec 11.5 scenario 2). The fight values are the QA kill step's (QaTimeouts,
    // QaFightPlan). Every spawn point is a home, the boss's too, so there is always something to fight and bots die
    // and respawn (the respawn path is part of the test).
    {
      "id": "field-combat",
      "homeMarkerIds": ["m1.spawn.combat.a", "m1.spawn.combat.b", "m1.spawn.combat.c", "m1.spawn.combat.d", "m1.spawn.combat.boss"],
      // Inside the 30 m interest radius (StartingValuesM1.interestRadiusCm), so a target stays in the snapshots.
      "targetSearchCm": 2500,
      "approachReachPercent": 55,
      // R-2.2-07: stop this far past body contact when the approach above lies inside a body (the boss's).
      "approachBodyMarginCm": 20,
      "healBelowPercent": 50,
      "backOffBelowPercent": 20,
      "backOffDistanceCm": 800,
      "backOffMs": 3000,
      // After a back-off it fights again at 40 % HP or with a self-heal usable, waiting 30 s at most, and starts no new
      // fight below 40 %. Placeholders mirroring the QA kill step (QaTimeouts.ReengageAbovePercent, BackOffRecoverSeconds).
      "reengageAbovePercent": 40,
      "backOffRecoverMs": 30000,
      "dodgeChancePercent": 30,
      "reactionMinMs": 150,
      "reactionMaxMs": 400,
      "pickupSearchCm": 1500,
      "pickupReachPercent": 40,
      // Drops are locked to the killer (R-4.3-02): after its own kill a bot loots first.
      "lootAfterKillMs": 8000,
      "stuckTimeoutMs": 3000,
      "stuckMinMoveCm": 20,
      // R-3.1-10: press through the 4-hit normal attack chain (WP-M2-12).
      "pressAttackChain": true
    },
    // field-combat with only hit 1 of the chain, as the M1 bots played: for the before/after comparison of WP-M2-12
    // (loadtest --behaviour field-combat-hit1).
    {
      "id": "field-combat-hit1",
      "homeMarkerIds": ["m1.spawn.combat.a", "m1.spawn.combat.b", "m1.spawn.combat.c", "m1.spawn.combat.d", "m1.spawn.combat.boss"],
      "targetSearchCm": 2500,
      "approachReachPercent": 55,
      "approachBodyMarginCm": 20,
      "healBelowPercent": 50,
      "backOffBelowPercent": 20,
      "backOffDistanceCm": 800,
      "backOffMs": 3000,
      "reengageAbovePercent": 40,
      "backOffRecoverMs": 30000,
      "dodgeChancePercent": 30,
      "reactionMinMs": 150,
      "reactionMaxMs": 400,
      "pickupSearchCm": 1500,
      "pickupReachPercent": 40,
      "lootAfterKillMs": 8000,
      "stuckTimeoutMs": 3000,
      "stuckMinMoveCm": 20,
      "pressAttackChain": false
    },
    // The M2 loop (WP-M2-12, spec 11.5 and 12.2): field-combat's fight values, played as steps round after round; every
    // step plays (learn: WP-M2-5, run: WP-M2-6).
    {
      "id": "m2-loop",
      // The first field zone (WP-M2-7): the M1 points and one point of every camp; each bot hunts the camps of its level
      // (homesByLevel) and moves on at each level-up, so the m2-exit run levels through the bands.
      "homeMarkerIds": [
        "m1.spawn.combat.a", "m1.spawn.combat.b", "m1.spawn.combat.c", "m1.spawn.combat.d", "field1.spawn.demon.a1",
        "field1.spawn.demon.b1", "field1.spawn.alien.a1", "field1.spawn.alien.b1", "field1.spawn.imp.a1",
        "field1.spawn.imp.b1", "field1.spawn.imp.c1", "field1.spawn.imp.d1", "field1.spawn.spitter.a1",
        "field1.spawn.spitter.b1", "field1.spawn.spitter.c1", "field1.spawn.spitter.d1", "field1.spawn.wolf.a1",
        "field1.spawn.wolf.b1", "field1.spawn.wolf.c1", "field1.spawn.wolf.d1", "field1.spawn.lurker.a1",
        "field1.spawn.lurker.b1", "field1.spawn.lurker.c1", "field1.spawn.lurker.d1", "field1.spawn.brute.a1",
        "field1.spawn.brute.b1", "field1.spawn.brute.c1", "field1.spawn.brute.d1", "field1.spawn.hellhound.a1",
        "field1.spawn.hellhound.b1", "field1.spawn.hellhound.c1", "field1.spawn.hellhound.d1"],
      "homesByLevel": true,
      "targetSearchCm": 2500,
      "approachReachPercent": 55,
      "approachBodyMarginCm": 20,
      "healBelowPercent": 50,
      "backOffBelowPercent": 20,
      "backOffDistanceCm": 800,
      "backOffMs": 3000,
      "reengageAbovePercent": 40,
      "backOffRecoverMs": 30000,
      "dodgeChancePercent": 30,
      "reactionMinMs": 150,
      "reactionMaxMs": 400,
      "pickupSearchCm": 1500,
      "pickupReachPercent": 40,
      "lootAfterKillMs": 8000,
      "stuckTimeoutMs": 3000,
      "stuckMinMoveCm": 20,
      "pressAttackChain": true,
      "loopSteps": ["fight", "pickup", "sell", "buy", "run", "learn", "rankUp", "equip"],
      "loopKillsPerRound": 1,
      "loopPickupIdleMs": 1500,
      "loopStepTimeoutMs": 120000,
      // PLACEHOLDERS: a few quotes again after QuoteExpired; keep 5 small HP potions (they do nothing until M3).
      "loopSellQuoteRetries": 2,
      "loopBuyItemId": "m2.potionHpSmall",
      "loopBuyKeep": 5,
      // PLACEHOLDER (WP-M2-6): runs of two kill offers, the fight step completes them, the run step claims them.
      "loopRunSteps": 2
    },
    // The 50-bot load run in the field zone (WP-M2-7, spec 11.5, scenario m2-zone): field-combat's fight values with one
    // home per camp of the zone, round robin by bot index, so bots spread over all four rings (interest and grid load with
    // the zone loaded). New characters in rings 3 and 4 die and walk back from the city: the respawn path is part of it.
    {
      "id": "field-zone",
      "homeMarkerIds": [
        "field1.spawn.demon.a1", "field1.spawn.demon.b1", "field1.spawn.alien.a1", "field1.spawn.alien.b1",
        "field1.spawn.imp.a1", "field1.spawn.imp.b1", "field1.spawn.imp.c1", "field1.spawn.imp.d1",
        "field1.spawn.spitter.a1", "field1.spawn.spitter.b1", "field1.spawn.spitter.c1", "field1.spawn.spitter.d1",
        "field1.spawn.wolf.a1", "field1.spawn.wolf.b1", "field1.spawn.wolf.c1", "field1.spawn.wolf.d1",
        "field1.spawn.lurker.a1", "field1.spawn.lurker.b1", "field1.spawn.lurker.c1", "field1.spawn.lurker.d1",
        "field1.spawn.brute.a1", "field1.spawn.brute.b1", "field1.spawn.brute.c1", "field1.spawn.brute.d1",
        "field1.spawn.hellhound.a1", "field1.spawn.hellhound.b1", "field1.spawn.hellhound.c1",
        "field1.spawn.hellhound.d1"],
      "targetSearchCm": 2500,
      "approachReachPercent": 55,
      "approachBodyMarginCm": 20,
      "healBelowPercent": 50,
      "backOffBelowPercent": 20,
      "backOffDistanceCm": 800,
      "backOffMs": 3000,
      "reengageAbovePercent": 40,
      "backOffRecoverMs": 30000,
      "dodgeChancePercent": 30,
      "reactionMinMs": 150,
      "reactionMaxMs": 400,
      "pickupSearchCm": 1500,
      "pickupReachPercent": 40,
      "lootAfterKillMs": 8000,
      "stuckTimeoutMs": 3000,
      "stuckMinMoveCm": 20,
      "pressAttackChain": true
    }
  ]
}
