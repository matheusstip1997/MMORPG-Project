      "pressAttackChain": true,
      "loopSteps": ["fight", "pickup", "sell", "buy", "run", "learn", "allocate", "rankUp", "equip"],
      // 12 kills per outpost visit. A round's walk share is W / (N x t + W): the camp-to-outpost round trip W is about 30 s
      // for demons and 110 s for hellhounds (markers.json, 4 m/s), the kill time t about 20 s (QA wave 1). One kill per round
      // walked 60 to 85 % of the time; 12 keep it near 30 % in ring 4 and 15 % for imps. The Normal bag (30 slots, stacks of
      // 99) holds 12 kills' drops in 2-3 slots. The fight loots each kill as it goes (FightStep).
      "loopKillsPerRound": 12,
      "loopPickupIdleMs": 1500,
      // 12 kills must fit a step: 10 min (the slowest kills measured about 40 s each); a fight still running then ends the
      // round and sells what it has.
      "loopStepTimeoutMs": 600000,
