      "backOffLeashMarginCm": 400,
      "avoidAggroMarginCm": 300,
      "dodgeChancePercent": 30,
      "reactionMinMs": 150,
      "reactionMaxMs": 400,
      "pickupSearchCm": 1500,
      "pickupReachPercent": 40,
