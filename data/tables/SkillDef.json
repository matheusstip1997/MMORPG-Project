    { "id": "swordman.focus", "actionId": "skill.swordman.focus", "damagePercentPerLevel": 10 },
    { "id": "swordman.pommelHit", "actionId": "skill.swordman.pommelHit", "damagePercentPerLevel": 10 },
    { "id": "swordman.heavyStrike", "parent": "warrior.jumpStrike", "actionId": "skill.swordman.heavyStrike" }
