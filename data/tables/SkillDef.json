{
  "table": "SkillDef",
  "version": 1,
  "rows": [
    // What each skill-tree node does (spec 3.5, R-3.5-05; WP-M2-5). Hand-authored; a node with no row cannot be learned yet.
    // An evolution names its base as parent and overrides only what changes (inheritance, resolved by SkillDefResolver;
    // print one with: dotnet run --project src/Tools/DataValidator -- --skill <id>). damagePercentPerLevel: each level above
    // 1 adds that many percent to the action's damage and heal percents (user decision 2026-10-27, PLACEHOLDER 10).
    // Passives: SkillModifierDef rows (times the level) or an armorClass (R-3.5-08). Weapon unlocks: the weapons are on the node.

    // Warrior root tree: the M1 kit (spec 3.5 backlog E) and Increase Def.
    { "id": "warrior.staminaBuff", "actionId": "skill.warrior.staminaBuff", "damagePercentPerLevel": 10 },
    { "id": "warrior.piercingAttack", "actionId": "skill.warrior.piercingAttack", "damagePercentPerLevel": 10 },
    { "id": "warrior.headCut", "actionId": "skill.warrior.headCut", "damagePercentPerLevel": 10 },
    { "id": "warrior.jumpStrike", "actionId": "skill.warrior.jumpStrike", "damagePercentPerLevel": 10 },
    { "id": "warrior.slash", "actionId": "skill.warrior.slash", "damagePercentPerLevel": 10 },
    { "id": "warrior.increaseDef" },

    // Archer root tree: the M1 kit (bow skills need a bow or dual crossbows: the node's weapons, R-3.5-07).
