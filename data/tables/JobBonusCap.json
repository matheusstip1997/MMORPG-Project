{
  "table": "JobBonusCap",
  "version": 1,
  // One cap per job bonus kind on the sum of its sources (spec 5.1, WP-M3-7; docs/design/job-trees.json "caps", decision 4):
  // IJobBonusQuery never returns more for one activity. The enchantOddsPercent row is the job-skill cap of R-5.3-04.
  // unlockMoldTiers is a tier set and has no cap. PLACEHOLDERS: every cap (balance is deferred).
  "rows": [
    { "id": "jobXpPercent", "kind": "jobXpPercent", "cap": 20 },
    { "id": "yieldPercent", "kind": "yieldPercent", "cap": 25 },
    { "id": "gemFindPercent", "kind": "gemFindPercent", "cap": 5 },
    { "id": "qualityBonus", "kind": "qualityBonus", "cap": 12 },
    { "id": "actionCount", "kind": "actionCount", "cap": 2 },
    { "id": "conversionOddsPercent", "kind": "conversionOddsPercent", "cap": 12 },
    { "id": "keepInputsPercent", "kind": "keepInputsPercent", "cap": 35 },
    { "id": "enchantOddsPercent", "kind": "enchantOddsPercent", "cap": 6 },
    { "id": "socketOddsPercent", "kind": "socketOddsPercent", "cap": 12 },
    { "id": "removalCostPercent", "kind": "removalCostPercent", "cap": 40 }
  ]
}
