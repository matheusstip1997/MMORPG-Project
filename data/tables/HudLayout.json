{
  "table": "HudLayout",
  "version": 1,
  "rows": [
    // HUD v1 (backlog I) in the 1280 x 720 reference space, from the absolute positions of spec 9.3. Offsets point into
    // the screen from the anchor; on a centered axis x places the element's center (x right). Size 0 = sized by content.
    // World overlays (name plates, monster HP bars, damage numbers, telegraphs) follow their entities and have no row,
    // except pickup_prompt and stagger_marker below.
    { "id": "resource_panel", "anchor": "topLeft", "offset": [8, 10], "size": [330, 112] },
    { "id": "boss_bar", "anchor": "topCenter", "offset": [0, 16], "size": [400, 44] },
    { "id": "chat", "anchor": "bottomLeft", "offset": [7, 7], "size": [330, 126] },
    { "id": "action_toast", "anchor": "bottomCenter", "offset": [0, 250], "size": [400, 30] },
    { "id": "cast_bar", "anchor": "bottomCenter", "offset": [0, 211], "size": [300, 30] },
    { "id": "buff_row", "anchor": "bottomCenter", "offset": [0, 138], "size": [160, 26] },
    { "id": "parry_dodge", "anchor": "bottomCenter", "offset": [-234, 46], "size": [52, 76] },
    // Hotbar slots by ActionBindings skill slot (spec 9.6): 1-6 are keys 1-6, 7 Q, 8 E, 9 R, 10 F, 11 Z; 0 unassigned.
    { "id": "hotbar_left", "anchor": "bottomCenter", "offset": [-130, 38], "size": [140, 92], "slots": [1, 2, 3, 4, 5, 6] },
    { "id": "gauge", "anchor": "bottomCenter", "offset": [0, 38], "size": [100, 92] },
    { "id": "hotbar_right", "anchor": "bottomCenter", "offset": [130, 38], "size": [140, 92], "slots": [7, 8, 9, 10, 11, 0] },
    // Exp bar under the hotbar and the multiplier note above it (spec 9.3, WP-M2-3; the note's 400x14 box is a placeholder).
    { "id": "exp_bar", "anchor": "bottomCenter", "offset": [0, 12], "size": [400, 6] },
    { "id": "exp_note", "anchor": "bottomCenter", "offset": [0, 21], "size": [400, 14] },
    // Inventory window (spec 9.13, WP16): placeholder place, right edge, vertically centered; grid in InventoryWindowSettings.
    { "id": "inventory_window", "anchor": "middleRight", "offset": [16, 0], "size": [300, 420] },
    // Pickup prompt (backlog G, placeholder): world-anchored, measured from the drop's projected ground point instead of
    // the screen (a zero-size box): centered on the drop, its bottom 24 px above it.
    { "id": "pickup_prompt", "anchor": "bottomCenter", "offset": [0, 24], "size": [150, 22] },
    // Stagger marker (R-3.3-01, placeholder): world-anchored, measured from the name plate's point above the monster's
    // head: centered over the plate, its bottom 32 px above that point (clear of the name and the lock chevron).
    { "id": "stagger_marker", "anchor": "bottomCenter", "offset": [0, 32], "size": [96, 20] },
    // Outposts and vendors (spec 9.13 M2, WP-M2-4; placeholders). The gold under the resource panel; the sale and vendor
    // windows on the left edge (the inventory window is on the right, so both show at once).
    { "id": "gold", "anchor": "topLeft", "offset": [8, 126], "size": [160, 24] },
    { "id": "outpost_window", "anchor": "middleLeft", "offset": [16, 0], "size": [320, 340] },
    { "id": "vendor_window", "anchor": "middleLeft", "offset": [16, 0], "size": [320, 260] },
    // NPC prompt (world-anchored like pickup_prompt): centered over the NPC's head point, its bottom 24 px above it.
    { "id": "npc_prompt", "anchor": "bottomCenter", "offset": [0, 24], "size": [180, 22] }
  ]
}
