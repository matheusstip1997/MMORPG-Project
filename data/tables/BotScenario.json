    // Bot load tests (backlog J, spec 11.5). The tick budget is one tick period (20 Hz: 50 ms). Spec 11.5 proposes a
    // tick p99 below half of it (the CI runs); the M1 exit criterion (spec 12.4) is within it with 50 bots.
    // CI on every push and pull request: about 20 bots for 2 minutes (user decision 2026-10-26).
    { "id": "ci-smoke", "bots": 20, "durationMs": 120000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "field-combat", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 50, "minInCombatPercent": 100, "maxDisconnects": 0 },
    // CI on pushes to main (merges): the 5 minutes of spec 11.5.
    { "id": "ci-merge", "bots": 20, "durationMs": 300000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "field-combat", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 50, "minInCombatPercent": 100, "maxDisconnects": 0 },
    // The M1 exit criterion, run locally with tools/load/Run-BotLoad.ps1 (also with -Link rtt100 and rtt200). 90% in combat:
    // 50 bots share the world's 5 monsters (about 10 per spawn point), and at 200 ms the last melee bot to arrive can lose
    // every respawn to the ranged ones (WP15 runs, 2026-10-26). The criterion that matters here is the tick p99.
    { "id": "m1-exit", "bots": 50, "durationMs": 300000, "rampPerSecond": 10, "enterTimeoutMs": 90000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "field-combat", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 90, "maxDisconnects": 0 },
    // The 50-bot load run in the first field zone (WP-M2-7, spec 11.5, plan "interest and grid settings checked with the
    // 50-bot run in the zone"): tools/load/Run-BotLoad.ps1 -Scenario m2-zone. Same tick criterion as m1-exit; bots spread
    // over the 28 camps walk 30 to 400 m and new characters die in the far rings, so fewer are in combat at once (50 %).
    { "id": "m2-zone", "bots": 50, "durationMs": 300000, "rampPerSecond": 10, "enterTimeoutMs": 90000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "field-zone", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 50, "maxDisconnects": 0 },
    // The M2 loop played by a few bots (WP-M2-12): a local check of the loop steps, BotClient loadtest --scenario m2-loop.
    { "id": "m2-loop", "bots": 5, "durationMs": 180000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "m2-loop", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 100, "maxDisconnects": 0 },
    // The M2 exit criterion (spec 12.2: a new character plays from level 1 to about 30 through the loop), run locally with
    // tools/load/Run-M2Exit.ps1: 5 new characters play the loop until all reach level 30 or the time limit. The 4 hours
    // are a placeholder from the spec 3.6 placeholder curve (about 520 kills from 1 to 30); revisit with the measured kill
    // rate once exp (WP-M2-3) and the field zone (WP-M2-7) land. It fails on the level until the protocol carries one.
    // Behaviour m2-exit (WP-M2-12): 12 kills per outpost visit and planned back-off legs; m2-loop is the before baseline
    // (Run-M2Exit.ps1 -Behaviour m2-loop).
    { "id": "m2-exit", "bots": 5, "durationMs": 14400000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "m2-exit", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 100, "maxDisconnects": 0,
      "targetLevel": 30, "levelSampleMs": 60000 },
    // The M3 loop played by a few bots (WP-M3-12): the M2 loop with the M3 steps mixed in, BotClient loadtest --scenario
    // m3-loop (--seed-level 12 to play the M3 steps at once). With the level seed each character also gets a pickaxe, 4 T1 ore,
    // 2 T1 ingots and a cyclops hide (seedItemIds, DbMigrate --give, once per character): a 180 s run earns about 70 gold per
    // bot and never holds the 50-gold pickaxe in time, so harvesting, refining and crafting would carry no load (wave 1 QA
    // F6); the ingots let the first round craft (one refine per round makes one ingot, the sword takes two).
    { "id": "m3-loop", "bots": 5, "durationMs": 180000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "m3-loop", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 100, "maxDisconnects": 0,
      "seedItemIds": ["m3.pickaxeT1", "m3.oreT1:4", "m3.ingotT1:2", "m1.cyclopsHide"] },
    // The M3 exit criterion (WP-M3-12; docs/plans/m3-jobs-crafting-plan.md section 1), tools/load/Run-M3Exit.ps1: two
    // fresh characters seeded to level 16 (DbMigrate --set-level, a test seed) play one script each, the Blacksmith (bot 0,
    // a warrior: the sword) and the Jeweler (bot 1). It passes when every entry is done; the run ends once both scripts
    // finished, at most 30 minutes (the gold and gather legs alone take about 13). In combat: the Blacksmith only (50 %).
    // Level 16, not 12 (wave 1 QA fix, orchestrator decision): at level 12 no grip source for the sword is reachable by these
    // two bots (the field boss is level 30, the wolves 16, recommended 13-19), so the forge, equip and wave 2 entries never
    // ran; the level-12 path returns in the balance phase. Test parameters only, no game rate. NOT YET (balance carry-over): the
    // grip leg. With the c1 wolves (off the boss route) and avoidBossTargets the Blacksmith no longer dies to the field boss,
    // but a lone level-16 bot dies to the ring 1-2 camps on the 217 m walk east (exit run 7: 20 imps and 5 spitters killed,
    // 1 wolf, the entry failed on its 4th death), so craft and equip:crafted stay not yet until the balance phase. WP-M3-14
    // (spec 5.3 M3 decision 13): the sword has no grip slot any more, so the script no longer fights the wolves for one.
    { "id": "m3-exit", "bots": 2, "durationMs": 3300000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "mage"], "behaviourId": "m3-exit-blacksmith", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 50, "maxDisconnects": 0,
      "seedLevel": 16, "botBehaviourIds": ["m3-exit-blacksmith", "m3-exit-jeweler"], "requireStepsDone": true },
    // M4 (WP-M4-12, spec 11.5): bots in pairs (bot 2k with bot 2k+1). ci-pair is the CI pair check (bot-smoke, every push):
    // two bots (level seed 5 and 4 demon ash each, as WP-M4-4's m4-trade) meet, play the wave 0 pair steps (party, whisper and
    // trade real; "not yet" passes), kill one monster each, read their seeded mail in the field and are refused the claim there,
    // claim it at the city's mailbox (WP-M4-14, R-4.5-03) and meet again; no step may fail. 4 minutes at most (it ends when
    // both scripts finished). The seed mail is an admin compensation of 1 demon ash and 10 gold per bot (DbMigrate --mail).
    { "id": "ci-pair", "bots": 2, "durationMs": 240000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer"], "behaviourId": "ci-pair-a", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 50, "minInCombatPercent": 0, "maxDisconnects": 0,
      "seedLevel": 5, "seedItemIds": ["m1.demonAsh:4"], "seedMail": ["m1.demonAsh:1:10"], "pairs": true,
      "botBehaviourIds": ["ci-pair-a", "ci-pair-b"], "requireNoFailedSteps": true },
    // The M4 loop for ongoing load: two pairs, every M4 step a placeholder until its WP.
    { "id": "m4-loop", "bots": 4, "durationMs": 180000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer", "mage", "assist"], "behaviourId": "m4-loop-a", "linkId": "rtt100",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 100, "maxDisconnects": 0,
      "pairs": true, "botBehaviourIds": ["m4-loop-a", "m4-loop-b"] },
    // The M4 exit run (tools/load/Run-M4Exit.ps1; plan section 1's seven legs): two fresh characters as a pair. The level
    // seed 25 is a placeholder at the top of the spec 12.3 band for party (12-18) and trade, auction and shops (20-25):
    // TODO(open) decision 14 (the exact unlock level per feature). Every entry done is the M4 exit; today the M4 legs are
    // "not yet" with the WP that lands them. The mail:claim entries are real (WP-M4-3) and fail "no open mail to claim" until
    // something mails the bots: B's proceeds by WP-M4-7 (listing) and A's by WP-M4-8 (stall) and WP-M4-7 (the cancelled
    // listing's return); until then that "failed" means "not yet". Each claim walks to the city's mailbox first (WP-M4-14,
    // R-4.5-03). At most 60 minutes (a placeholder).
    { "id": "m4-exit", "bots": 2, "durationMs": 3600000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "archer"], "behaviourId": "m4-exit-a", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 50, "maxDisconnects": 0,
      "seedLevel": 25, "pairs": true, "botBehaviourIds": ["m4-exit-a", "m4-exit-b"], "requireStepsDone": true },
    // WP-M4-4's end-to-end trade (spec 4.5): a pair sells its seeded horns, then trades ash for gold; the script outcomes say done.
    // Run locally (src/Tools/BotClient/README.md) against a GameServer on the branch's own databases (--db-suffix).
    { "id": "m4-trade", "bots": 2, "durationMs": 300000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "mage"], "behaviourId": "m4-trade-giver", "linkId": "lan",
      "tickP99MaxPercentOfPeriod": 100, "minInCombatPercent": 0, "maxDisconnects": 0,
      "seedLevel": 5, "seedItemIds": ["m1.demonHorn:20", "m1.demonAsh:10"], "pairs": true, "botBehaviourIds": ["m4-trade-giver", "m4-trade-payer"] },
    // WP-M4-6's party loot (spec 4.3 R-4.3-02, M4 decision 2): two warriors in a party hunt the same camps; every pickup of a party
    // drop rolls among them, and the report (report --kind economy) prints the units each won, every roll logged with its seed
