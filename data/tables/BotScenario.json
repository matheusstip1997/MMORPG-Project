    { "id": "m4-party-loot", "bots": 2, "durationMs": 600000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "warrior"], "behaviourId": "m4-party-loot-a", "linkId": "lan",
