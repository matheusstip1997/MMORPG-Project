    { "id": "m3-exit", "bots": 2, "durationMs": 1200000, "rampPerSecond": 5, "enterTimeoutMs": 60000,
      "classes": ["warrior", "mage"], "behaviourId": "m3-exit-blacksmith", "linkId": "lan",
