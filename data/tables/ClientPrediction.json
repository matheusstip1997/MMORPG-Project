      "correctionSmoothingMs": 120,
      // 3.2 s of inputs at 20 Hz.
      "maxPendingInputs": 64,
      // Matches ServerLoop.MaxQueuedInputFrames.
      "maxTicksPerFrame": 4,
      "interpolationClockCatchUpMs": 500
    }
  ]
