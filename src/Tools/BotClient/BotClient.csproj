<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless bot client and load-test harness (backlog J, spec 11.5). It plays through the Unity client's own
       engine-free code (ClientCore) and the Auth API, never through server internals: no GameServer reference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
    <ProjectReference Include="..\ClientCore\ClientCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameServer.Tests" />
  </ItemGroup>

</Project>
