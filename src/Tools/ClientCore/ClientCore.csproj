<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine-free sources of the Unity client compiled for .NET (backlog J): the same files Unity compiles, not
       copies. GameServer.Tests runs them against the real server; BotClient plays the game with them (spec 11.5). Only
       files without UnityEngine API belong here; keep C# 9 as Unity does (architecture rule 7). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The connection (spec 2.5, 11.2), prediction (D1, D2) and entity cores (snapshots, interpolation, projectiles). -->
    <Compile Include="..\..\..\unity\Assets\Game\Net\Client\*.cs" LinkBase="Net" />
    <Compile Include="..\..\..\unity\Assets\Game\Prediction\Core\*.cs" LinkBase="Prediction" />
    <Compile Include="..\..\..\unity\Assets\Game\Entities\Core\*.cs" LinkBase="Entities" />
    <!-- The Auth API client of the login screens (spec 9.10); the HTTP transport is the caller's (IAuthHttp). -->
    <Compile Include="..\..\..\unity\Assets\Game\UI\Auth\AuthApiClient.cs;..\..\..\unity\Assets\Game\UI\Auth\AuthHttp.cs;..\..\..\unity\Assets\Game\UI\Auth\AuthJson.cs" LinkBase="Auth" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameServer.Tests" />
  </ItemGroup>

</Project>
