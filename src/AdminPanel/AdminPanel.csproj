<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The same flag as the Auth API: the dev admin sign-in exists only in Debug builds (DevLogin=true). -->
  <Import Project="..\AuthApi\DevLogin.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep the caller's folder so data/tables and telemetry resolve from the repo root, like the Auth API. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!-- Persistence, the admin action log, lock keys and the listen policy come from the game server project, so each
       has one implementation (as for the Auth API). -->
  <ItemGroup>
    <ProjectReference Include="..\GameServer\GameServer.csproj" />
  </ItemGroup>

  <!-- Without the flag, the dev admin identity is not compiled: a Release build has no admin sign-in at all. -->
  <ItemGroup Condition="'$(DevLogin)' != 'true'">
    <Compile Remove="Identity\Dev\**" />
  </ItemGroup>

  <!-- The static page is served from the binaries' folder (AdminPanelApp), so dotnet run and the container match. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdminPanel.Tests" />
  </ItemGroup>

</Project>
