<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="DevLogin.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The Web SDK runs from the project folder; keep the caller's folder so data/tables resolves from the repo root,
         as it does for the game server. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!-- Tickets (Net/Tickets) and persistence come from the game server project, so there is one implementation of each.
       Extracting them into a shared server library is a later step. -->
  <ItemGroup>
    <ProjectReference Include="..\GameServer\GameServer.csproj" />
  </ItemGroup>

  <!-- See DevLogin.props: without the flag, the dev identity provider is not compiled. -->
  <ItemGroup Condition="'$(DevLogin)' != 'true'">
    <Compile Remove="Identity\Dev\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthApi.Tests" />
  </ItemGroup>

</Project>
