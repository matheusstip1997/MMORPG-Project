# Optional overrides for docker-compose.yml (dev only). Copy to .env (git-ignored) and change what you need;
# `docker compose up -d --wait` works without any .env.

# Host ports, all bound to 127.0.0.1. The Unity login screens use ServerDirectory's 127.0.0.1:7777 for the game server
# and LoginSettings' Auth API URL (http://127.0.0.1:5080): change those locally (do not commit) if you move these.
#POSTGRES_PORT=5432
#REDIS_PORT=6379
#AUTH_PORT=5080
#GAME_PORT=7777
#ADMIN_PORT=5090

# Own databases and Redis keys for a branch with a new migration (CLAUDE.md, DbMigrate --db-suffix):
# mmorpg_global_<suffix>, mmorpg_realm_1_<suffix> and keys under mmorpg:<suffix>:.
#MMORPG_DB_SUFFIX=

# The GameServer's dev tools (spec 11.7): the dev console (chat commands such as /give, /level for dev logins; usage in
# unity/Assets/Game/Dev/README.md), table hot reload and the strike trace.
#MMORPG_DEV_TOOLS=1

# Secrets: empty means generated once into the dev-secrets volume (`docker compose down -v` deletes them).
# To share a ticket secret with servers started by hand, set it here (base64 of at least 32 random bytes).
#MMORPG_TICKET_SECRET=
#MMORPG_AUTH_TOKEN_SECRET=

# PostgreSQL superuser of the dev server (the same defaults as the manual workflow and CI).
#POSTGRES_USER=mmorpg
#POSTGRES_PASSWORD=mmorpg_dev
#POSTGRES_DB=mmorpg

# Another compose project (own containers and volumes), for example to try a branch next to the shared stack.
#COMPOSE_PROJECT_NAME=mmorpg
